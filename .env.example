# データベース(PostgreSQL)
# ニュース・企業掲載データの保存先。
# 推奨: Neon (https://neon.tech) の無料プラン。期限切れでデータが削除される仕組みが
# 無く、クレジットカードも不要(RenderのFree PostgreSQLは30日+14日でデータが自動削除
# されるため非推奨。README「データの永続化について」参照)。
# Neonのダッシュボードの「Connect」から接続文字列(Pooled connectionを推奨)を
# コピーしてそのまま貼り付ければよい(sslmode=require等のパラメータはそのままでよい)。
# これを設定しないと /api/news, /api/companies 系はすべてエラーになる。
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# ローカルの非SSL Postgresで試す場合のみ DATABASE_SSL=false を追加する(Neon/Render等の
# マネージドPostgresでは不要)。
# DATABASE_SSL=false

# Pi Network
# PI_API_KEYはPi決済のapprove/complete処理で実際に使用される(未設定だと決済APIがエラーになる)
PI_API_KEY=your_pi_developer_portal_api_key
# true(既定): Pi SDKはSandbox/テストネットモードで動作(実際のPiは動かない)
# false: 本番モード。実際のPiが動く。動作確認が済んでから切り替えること。
# フロントエンドは /api/config からこの値を取得するため、切り替えにコード編集は不要。
PI_SANDBOX=true

# NewsData.io (https://newsdata.io) - 無料枠: 1日200クレジット、商用利用可
NEWSDATA_API_KEY=your_newsdata_api_key

# MyMemory Translation API (https://mymemory.translated.net) - 完全無料・APIキー不要
# ニュース記事(英語)を ja/zh/ko/es に自動翻訳するために使用。
# 匿名利用は1日5,000文字までだが、1回の更新(記事8件×4言語)だけでこれに近い/
# 超える文字数を消費する可能性があるため、下のメールアドレスの設定を強く推奨する
# (設定すると1日50,000文字まで無料枠が拡大する。クレジットカード登録は不要)。
# 空のままでも動作するが、翻訳が上限に達した言語は英語原文にフォールバックされる。
TRANSLATE_EMAIL=your_email@example.com

# ニュース自動更新の間隔(日数)
NEWS_FETCH_INTERVAL_DAYS=3

# 管理者用トークン。以下の用途で使用する(第三者に推測されにくいランダムな文字列にすること):
# - ニュースの手動更新API (/api/news/refresh)
# - 管理画面 (/admin.html) と管理API (/api/admin/*) — 掲載の一覧・ステータス変更・削除
ADMIN_TOKEN=change_this_to_a_random_secret

# サーバーポート
PORT=3000
